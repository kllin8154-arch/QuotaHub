<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="17dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quota_widget_bg">
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="QuotaHub"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="QuotaHub"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#F7FAFF"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_accounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="尚未绑定账号"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"/>
    <TextView android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="点击进入应用绑定"
        android:textColor="#D1D7E0"
        android:textSize="11sp"/>
</LinearLayout>
